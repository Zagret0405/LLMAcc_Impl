{
  "model_name": "GPT-2",
  "dimensions": {
    "D_MODEL": "model.hidden_size",
    "D_FFN": "model.ffn_size",
    "SEQ_LEN": "config.seq_len"
  },
  "layer_graph": {
    "inputs": [
      "x_layer_in"
    ],
    "outputs": [
      "x_layer_out"
    ],
    "nodes": [
      {
        "name": "attn_norm",
        "type": "LayerNorm",
        "inputs": [
          {
            "source": "x_layer_in",
            "type": "streaming"
          }
        ],
        "deployment": "spatial"
      },
      {
        "name": "K_proj",
        "type": "Linear",
        "inputs": [
          {
            "source": "attn_norm",
            "type": "streaming"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_MODEL",
          "d_out": "D_MODEL"
        },
        "caches_output": "kv_cache",
        "require_offchip_memory": true,
        "deployment": "spatial"
      },
      {
        "name": "V_proj",
        "type": "Linear",
        "inputs": [
          {
            "source": "attn_norm",
            "type": "streaming"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_MODEL",
          "d_out": "D_MODEL"
        },
        "caches_output": "kv_cache",
        "require_offchip_memory": true,
        "deployment": "spatial"
      },
      {
        "name": "Q_proj",
        "type": "Linear",
        "inputs": [
          {
            "source": "K_proj",
            "type": "blocking"
          },
          {
            "source": "B_proj",
            "type": "blocking"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_MODEL",
          "d_out": "D_MODEL"
        },
        "require_offchip_memory": true,
        "deployment": "spatial"
      },
      {
        "name": "attn_scores_qk",
        "type": "BatchMatmul",
        "inputs": [
          {
            "source": "Q_proj",
            "type": "streaming"
          },
          {
            "source": "K_proj",
            "type": "blocking"
          }
        ],
        "mac_calc": {
          "m": "SEQ_LEN",
          "k": "D_MODEL",
          "n": "SEQ_LEN"
        },
        "deployment": "spatial"
      },
      {
        "name": "attn_softmax",
        "type": "Softmax",
        "inputs": [
          {
            "source": "attn_scores_qk",
            "type": "streaming"
          }
        ],
        "deployment": "spatial"
      },
      {
        "name": "attn_context_wv",
        "type": "BatchMatmul",
        "inputs": [
          {
            "source": "attn_softmax",
            "type": "streaming"
          },
          {
            "source": "V_proj",
            "type": "blocking"
          }
        ],
        "mac_calc": {
          "m": "SEQ_LEN",
          "k": "SEQ_LEN",
          "n": "D_MODEL"
        },
        "deployment": "spatial"
      },
      {
        "name": "O_proj",
        "type": "Linear",
        "inputs": [
          {
            "source": "attn_context_wv",
            "type": "streaming"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_MODEL",
          "d_out": "D_MODEL"
        },
        "require_offchip_memory": true,
        "deployment": "spatial"
      },
      {
        "name": "attn_add",
        "type": "Add",
        "inputs": [
          {
            "source": "x_layer_in",
            "type": "blocking"
          },
          {
            "source": "O_proj",
            "type": "streaming"
          }
        ],
        "deployment": "spatial"
      },
      {
        "name": "ffn_norm",
        "type": "LayerNorm",
        "inputs": [
          {
            "source": "attn_add",
            "type": "streaming" 
          }
        ],
        "deployment": "spatial"
      },
      {
        "name": "ffn_up",
        "type": "Linear",
        "activation": "GELU",
        "inputs": [
          {
            "source": "ffn_norm",
            "type": "streaming"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_MODEL",
          "d_out": "D_FFN"
        },
        "require_offchip_memory": true,
        "requires_input_buffer": true,
        "deployment": "spatial"
      },
      {
        "name": "ffn_down",
        "type": "Linear",
        "inputs": [
          {
            "source": "ffn_up",
            "type": "streaming"
          }
        ],
        "mac_calc": {
          "l": "SEQ_LEN",
          "d_in": "D_FFN",
          "d_out": "D_MODEL"
        },
        "require_offchip_memory": true,
        "deployment": "spatial"
      },
      {
        "name": "_out",
        "type": "Add",
        "inputs": [
          {
            "source": "attn_add",
            "type": "blocking"
          },
          {
            "source": "ffn_down",
            "type": "blocking"
          }
        ],
        "deployment": "spatial"
      }
    ]
  }
}